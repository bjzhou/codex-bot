# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs; private chats only; users must first /start the Bot
ALLOWED_TELEGRAM_USER_IDS=
# Optional Codex binary. Auto-detects desktop bundled CLI, then PATH.
CODEX_CLI_PATH=
# Defaults to ~/.codex
CODEX_HOME=
# Optional explicit paginated history SQLite path (read-only)
CODEX_HISTORY_DB=
# Optional state directory; defaults to .bot/<bot-identity>/
BOT_STATE_DIR=
# Progress/completion polling interval; default 5000 ms, minimum 3000 ms
POLL_INTERVAL_MS=5000
